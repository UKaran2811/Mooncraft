# ═══════════════════════════════════════════════════════════
#  MOONCRAFT — ENVIRONMENT VARIABLES
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git. It is already in .gitignore.
# ═══════════════════════════════════════════════════════════

# ── Node ─────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Supabase ─────────────────────────────────────────────
# 1. Go to https://supabase.com → Create project (free)
# 2. Settings → API → copy the values below
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...           # Public anon key  (safe for frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...   # Service role key (KEEP SECRET — backend only)

# ── Frontend URL (for CORS & email links) ────────────────
# Local dev:
FRONTEND_URL=http://localhost:3000
# After Vercel deploy, update to your live URL:
# FRONTEND_URL=https://mooncraft.vercel.app
APP_URL=http://localhost:3000

# ── Vite frontend env (prefix VITE_ so Vite exposes them) ─
# This tells the React app where the API lives
# Local dev: points to the local Express server
VITE_API_URL=http://localhost:5000/api
# After Vercel deploy, update to:
# VITE_API_URL=https://mooncraft.vercel.app/api

# ── JWT Secrets ──────────────────────────────────────────
# Generate strong secrets:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_64_CHAR_RANDOM_HEX
JWT_ADMIN_SECRET=REPLACE_WITH_ADMIN_SPECIFIC_64_CHAR_RANDOM_HEX

# ── Admin Seeder Account ─────────────────────────────────
# Used by `npm run seed` to create the first super admin
ADMIN_EMAIL=admin@mooncraft.in
ADMIN_NAME=Mooncraft Admin
ADMIN_DEFAULT_PASSWORD=Mooncraft@Admin2024!
#  ⚠️  CHANGE THIS PASSWORD immediately after first login!

# ── Resend (transactional email — Cloudflare-Workers friendly) ─
# Steps:
#   1. Sign up at https://resend.com
#   2. Add & verify your domain (or use onboarding@resend.dev for testing)
#   3. Copy API key from API Keys page
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
ADMIN_EMAIL_RECIPIENT=yourbusiness@gmail.com

# ── WhatsApp Admin Alerts (Free — CallMeBot) ─────────────
# One-time 2-minute setup:
#   1. Save +34 644 59 77 79 in WhatsApp as "CallMeBot"
#   2. Send this exact message to it:
#      "I allow callmebot to send me messages"
#   3. You'll receive your API key via WhatsApp reply
CALLMEBOT_PHONE=+91XXXXXXXXXX
CALLMEBOT_API_KEY=XXXXXX

# ── Shiprocket (order delivery automation) ───────────────
# Sign up: https://www.shiprocket.in/ (free signup)
# Panel → My Account → API token (or use dashboard login email+password)
SHIPROCKET_EMAIL=your_shiprocket_login_email
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_PICKUP_LOCATION=Home
SHIPROCKET_STORE_PINCODE=395003
SHIPROCKET_WEBHOOK_SECRET=generate-a-random-string

# ── Razorpay Payment Gateway ─────────────────────────────
# Free account: https://razorpay.com (2% per transaction)
# Dashboard → Settings → API Keys → Generate Test Key
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Gemini AI (existing, keep as-is) ─────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
